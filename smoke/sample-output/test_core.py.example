from __future__ import annotations

import pytest

from fizzbuzz.core import fizzbuzz


class TestFizzbuzz:
    def test_returns_number_as_string_when_not_divisible(self) -> None:
        assert fizzbuzz(1) == "1"
        assert fizzbuzz(7) == "7"

    def test_returns_fizz_when_divisible_by_three(self) -> None:
        assert fizzbuzz(3) == "Fizz"
        assert fizzbuzz(9) == "Fizz"

    def test_returns_buzz_when_divisible_by_five(self) -> None:
        assert fizzbuzz(5) == "Buzz"
        assert fizzbuzz(20) == "Buzz"

    def test_returns_fizzbuzz_when_divisible_by_fifteen(self) -> None:
        assert fizzbuzz(15) == "FizzBuzz"
        assert fizzbuzz(45) == "FizzBuzz"

    def test_raises_value_error_when_not_positive(self) -> None:
        with pytest.raises(ValueError):
            fizzbuzz(0)
        with pytest.raises(ValueError):
            fizzbuzz(-3)
